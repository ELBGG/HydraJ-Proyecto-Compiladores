  "patterns": [
    {
      "from": "\\bsistema\\.imprimir\\b",
      "flags": "g",
      "to": "System.out.println"
    },
    {
      "from": "\\bsistema\\.imprimir_linea\\b",
      "flags": "g",
      "to": "System.out.println"
    },
    {
      "from": "\\bsistema\\.imprimir_error\\b",
      "flags": "g",
      "to": "System.err.println"
    },
    {
      "from": "\\bsistema\\.leer\\b",
      "flags": "g",
      "to": "System.in.read"
    },
    {
      "from": "\\bmatematicas\\.aleatorio\\b",
      "flags": "g",
      "to": "Math.random"
    },
    {
      "from": "\\bmatematicas\\.abs\\.\\(([^)]+)\\)",
      "flags": "g",
      "to": "Math.abs($1)"
    },
    {
      "from": "\\bmatematicas\\.potencia\\.\\(([^,]+),\\s*([^)]+)\\)",
      "flags": "g",
      "to": "Math.pow($1, $2)"
    },
    {
      "from": "\\bmatematicas\\.raiz\\.\\(([^)]+)\\)",
      "flags": "g",
      "to": "Math.sqrt($1)"
    },
    {
      "from": "\\bmatematicas\\.maximo\\.\\(([^,]+),\\s*([^)]+)\\)",
      "flags": "g",
      "to": "Math.max($1, $2)"
    },
    {
      "from": "\\bmatematicas\\.minimo\\.\\(([^,]+),\\s*([^)]+)\\)",
      "flags": "g",
      "to": "Math.min($1, $2)"
    },
    {
      "from": "\\bmatematicas\\.piso\\.\\(([^)]+)\\)",
      "flags": "g",
      "to": "Math.floor($1)"
    },
    {
      "from": "\\bmatematicas\\.techo\\.\\(([^)]+)\\)",
      "flags": "g",
      "to": "Math.ceil($1)"
    }
  ],
  "blockTemplate": {
    "style": "braces",
    "main": "publico estatico vacio principal(cadena[] argumentos)",
    "mainRequiresClass": true,
    "class": "clase {NAME}",
    "method": "{SIGNATURE}",
    "lineComment": "//",
    "ifKeyword": "si",
    "elseKeyword": "sino",
    "whileKeyword": "mientras",
    "forKeyword": "para",
    "doKeyword": "hacer",
    "supportsDoWhile": true,
    "forStyle": "c-style",
    "switchKeyword": "cambiar",
    "supportsTryCatch": true,
    "tryKeyword": "intentar",
    "catchKeyword": "capturar",
    "print": "sistema.imprimir({TEXT})",
    "printError": "sistema.imprimir_error({TEXT})",
    "varDecl": "{TYPE} {VAR}",
    "returnKeyword": "retornar",
    "throwTemplate": "lanzar nuevo {EXC}",
    "breakKeyword": "romper",
    "continueKeyword": "continuar"
  }
