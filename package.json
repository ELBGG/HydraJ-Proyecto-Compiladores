{
  "name": "hydracode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && set NODE_ENV=development&& electron .\"",
    "electron:build": "npm run build && set NODE_ENV=production&& electron .",
    "electron:preview": "set NODE_ENV=production&& electron .",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^42.3.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
