{
  "name": "hydracode",
  "version": "0.1.0-pre-alpha.1",
  "description": "Educational IDE that transpiles Spanish (and other human-language) keyword source into real Java/C/C++/Python/Go.",
  "author": "ELBGG",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ELBGG/HydraJ-Proyecto-Compiladores.git"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && set NODE_ENV=development&& electron .\"",
    "electron:build": "npm run build && set NODE_ENV=production&& electron .",
    "electron:preview": "set NODE_ENV=production&& electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "concurrently": "^9.1.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "blockly": "^12.5.1",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "vosk-browser": "^0.0.8",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "build": {
    "appId": "com.hydracode.app",
    "productName": "HydraCode",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "ELBGG",
      "repo": "HydraJ-Proyecto-Compiladores",
      "releaseType": "prerelease"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "HydraCode"
    }
  }
}
